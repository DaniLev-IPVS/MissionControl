# Notion internal integration secret (notion.so/profile/integrations).
# Leave empty locally to run against mock data.
NOTION_TOKEN=

# Site login (admin). Required in production; the site refuses access without them.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Verification token Notion sends when you create the webhook subscription.
NOTION_WEBHOOK_SECRET=

# Optional overrides (defaults point at the Personal Ticket Board and Sprints).
# NOTION_TASKS_DATA_SOURCE_ID=
# NOTION_SPRINTS_DATA_SOURCE_ID=

# AI planner (local only; Vercel uses OIDC automatically)
# AI, option 1 (preferred): your own Anthropic key, billed by Anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5   # or claude-sonnet-5-5 for half the price
# AI, option 2: Vercel AI Gateway (used when ANTHROPIC_API_KEY is empty).
AI_GATEWAY_API_KEY=
# PLANNER_MODEL=anthropic/claude-opus-5.5
# NOTION_DAYS_DATA_SOURCE_ID=

# Neon Postgres (set by the Vercel Neon integration): AI recommendation history and the
# company master (goals, roadmaps, pivots). Needed locally for the Company view and `npm run company:sync`.
DATABASE_URL=
