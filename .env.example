# Notion internal integration secret (notion.so/profile/integrations).
# Leave empty locally to run against mock data.
NOTION_TOKEN=

# Password for the site. Required in production (the site refuses access without it).
SITE_PASSWORD=

# Verification token Notion sends when you create the webhook subscription.
NOTION_WEBHOOK_SECRET=

# Optional overrides (defaults point at the Personal Ticket Board and Sprints).
# NOTION_TASKS_DATA_SOURCE_ID=
# NOTION_SPRINTS_DATA_SOURCE_ID=
